{
  "name": "start",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "node scripts/dev-start.js && concurrently \"ng serve\" \"json-server --watch db.json --port 3000\" \"npm run proxy\"",
    "proxy": "npm --prefix backend run dev",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "mock-server": "json-server --watch db.json --port 3000",
    "env:encrypt": "node scripts/encrypt-env.js",
    "env:decrypt": "node scripts/decrypt-env.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@jsverse/transloco": "^8.4.0",
    "@types/crypto-js": "^4.2.2",
    "@types/qrcode": "^1.5.6",
    "angular-icons": "^1.0.11",
    "crypto-js": "^4.2.0",
    "firebase": "^12.18.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.4.3",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "~6.0.0",
    "autoprefixer": "^10.5.4",
    "axios": "^1.20.0",
    "concurrently": "^9.1.2",
    "jasmine-core": "~7.0.2",
    "json-server": "^1.0.0-beta.15",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  }
}
