# MotoWorkshop CRM — Environment Variables
# Copy this file to .env.local and fill in your real values.
# .env.local is listed in .gitignore and must NEVER be committed.

# ── Firebase ───────────────────────────────────────────────────────────────────
NG_APP_FIREBASE_API_KEY=your-firebase-api-key
NG_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NG_APP_FIREBASE_PROJECT_ID=your-project-id
NG_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NG_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
NG_APP_FIREBASE_APP_ID=1:123456789:web:abcdef

# ── Groq AI ────────────────────────────────────────────────────────────────────
NG_APP_GROQ_API_KEY=gsk_your_groq_api_key_here
NG_APP_GROQ_MODEL=llama-3.3-70b-versatile

# ── App ────────────────────────────────────────────────────────────────────────
NG_APP_ENV=development
