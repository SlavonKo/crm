# MotoWorkshop CRM — Environment Variables
# Copy this file to .env.local and fill in your real values.
# .env.local is listed in .gitignore and must NEVER be committed.
#
# After filling in .env.local, run:
#   node scripts/encrypt-env.js
# to produce .env.encrypted — a ciphertext file you CAN commit safely.
# The Node backend reads .env.encrypted and decrypts it at startup.

# ── Firebase ───────────────────────────────────────────────────────────────────
NG_APP_FIREBASE_API_KEY=your-firebase-api-key
NG_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NG_APP_FIREBASE_PROJECT_ID=your-project-id
NG_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NG_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
NG_APP_FIREBASE_APP_ID=1:123456789:web:abcdef

# ── Groq AI (server-side only — never exposed to the browser) ─────────────────
# Used by backend/src/index.ts to call the Groq API on the server.
# Do NOT add an NG_APP_ prefix here.
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Backend / Node ─────────────────────────────────────────────────────────────
# Secret used both to encrypt .env.encrypted and as JWT signing key.
# Minimum 32 characters, use a random string.
SERVER_SECRET=your-super-secret-32-char-minimum-string

# Port the Express API will listen on
SERVER_PORT=4000

# ── App ────────────────────────────────────────────────────────────────────────
NG_APP_ENV=development
